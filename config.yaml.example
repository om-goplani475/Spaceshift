# Copy this file to config.yaml and adjust as needed.
# Every option below shows its default value.
#
# This file is deliberately narrow: identity (accounts/credentials) and
# secrets (notifications) only. Everything else - default_threshold_percent,
# dry_run, scheduler.*, resize.* - lives in Postgres's app_config table
# instead, editable live without a restart. See docs/SETUP.md's
# "Live-editable settings" section for the full list, defaults, and how to
# change them (direct SQL for now; a dashboard Settings tab is planned).
#
# The controller talks to instances exclusively via SSM Send-Command - no
# inbound port, no SSH keys to manage. Target instances need the SSM Agent
# running and AmazonSSMManagedInstanceCore on their own instance profile;
# see docs/SETUP.md section 1.2.
#
# State is always the bundled Postgres container from docker-compose.yml -
# not configurable here. Only its password varies, via the POSTGRES_PASSWORD
# env var (see docs/SETUP.md's config reference) - not a config.yaml field,
# since both the postgres container and the controller need to agree on it.

# --- Accounts ---
# One entry per AWS account the controller manages. Every account
# authenticates through the same base identity below (credentials.*) - what
# makes each entry a *different* account is its own assume_role_arn, so one
# controller process can centrally manage several accounts at once.
#
# The single-account case is just a list with one entry, as below. Add more
# entries (each with its own assume_role_arn and regions) to manage
# additional accounts from the same controller.
accounts:
  - name: default
    # Optional: assume a role in this account before making any AWS calls.
    # Leave unset to use the base identity directly (its own account).
    # assume_role_arn: "arn:aws:iam::123456789012:role/spaceshift"
    regions:
      - us-east-1
  # - name: prod-secondary
  #   assume_role_arn: "arn:aws:iam::210987654321:role/spaceshift"
  #   regions:
  #     - us-east-1
  #     - eu-west-1

# --- Credentials ---
# "role" (default): use the controller's own default credential chain - an
# EC2 instance role, typically. Leave this section alone if the controller
# runs on EC2 with a role attached (recommended - see docs/SETUP.md 1.1).
# "static": authenticate with an IAM user's access key instead, for
# deployments with no instance role available (own server, another cloud,
# local testing). This file is gitignored once copied to config.yaml, same
# as the Slack bot token below - never commit real keys here.
credentials:
  mode: role
  # aws_access_key_id: ""
  # aws_secret_access_key: ""
  # aws_session_token: ""  # only for temporary credentials

# Eligibility isn't a config.yaml setting or an AWS tag - every instance and
# volume the controller can see gets synced into Postgres each cycle, and
# eligibility is an `autoresize` column you toggle from the dashboard. See
# docs/SETUP.md.

# default_threshold_percent, dry_run, scheduler.*, and resize.* used to live
# here. They're now Postgres app_config keys instead (same defaults, see
# docs/SETUP.md) - nothing to set in this file to get those defaults, and
# changing them takes effect on the controller's next cycle, no restart.

# --- Notifications ---
notifications:
  # "slack", "email", or "none"
  method: none
  # Requires a Slack app with a bot token (xoxb-...) granted the chat:write
  # scope, installed to your workspace, and invited to the target channel
  # (or granted chat:write.public to post without being invited). See
  # docs/SETUP.md for step-by-step setup.
  # slack_bot_token: "xoxb-..."
  # slack_channel_id: "C0123456789"
