# Copy this file to .env and set a real password. docker compose reads .env
# automatically for variable substitution in docker-compose.yml - this is
# separate from config.yaml's AWS credentials (see config.yaml.example):
# Postgres is a plain stock image (postgres:16-alpine) with no way to read
# config.yaml, so its password has to come from here instead.
#
# docker compose up refuses to start if this isn't set - there's no
# fallback default, since a fallback anyone could find in this public repo
# defeats the point of having a password at all.
#
# This file is gitignored - never commit a real password here.
POSTGRES_PASSWORD=
