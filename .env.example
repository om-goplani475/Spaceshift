# Copy this file to .env and fill in the values. docker compose reads .env
# automatically for variable substitution in docker-compose.yml.
#
# This is the ONE place secrets live. Everything else - AWS accounts,
# regions, roles, notification channel, every operational setting - is
# managed on the dashboard. This file is gitignored; never commit a real
# .env, and keep it readable by you only (chmod 600).

# Postgres password. docker compose up refuses to start without it - a
# fallback anyone could find in this public repo defeats the point of
# having a password at all.
#
# Any characters are fine (the controller encodes them for its connection
# string) - except `$`, which docker compose treats as variable expansion
# inside .env. Write it as `$$` if you must use one.
POSTGRES_PASSWORD=

# Signs the dashboard's session cookies. Required, at least 32 characters.
# Generate one:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Changing it signs every user out; that's all it does.
SPACESHIFT_SECRET_KEY=

# Guards http://localhost:8089/setup, the page that creates the first
# dashboard admin. Choose it yourself, at least 16 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
# Once a user exists the page is a 404 and this value is ignored - you can
# delete the line. Leave it unset to skip the page entirely and create the
# first admin from the CLI instead:
#   docker compose exec dashboard python -m controller.dashboard.users create-admin <name>
SPACESHIFT_SETUP_TOKEN=

# Set to true only when an HTTPS reverse proxy (nginx, Caddy, an ALB) is in
# front of the dashboard. It marks the session cookie Secure (so browsers
# refuse to send it over plain HTTP) and trusts X-Forwarded-For/-Proto
# from exactly one hop, so login rate limiting sees real client addresses.
# Leave false for localhost or an SSH tunnel - with it true and no proxy,
# the cookie is silently dropped and login never "takes".
SPACESHIFT_BEHIND_TLS_PROXY=false

# Slack alerts (optional). The Bot User OAuth Token from your Slack app
# (docs/SETUP.md section 2) - the only Slack value that's a secret. Pick
# the channel and turn Slack on from the dashboard's Settings page.
SPACESHIFT_SLACK_BOT_TOKEN=

# AWS credentials - ONLY when the host has no IAM instance role (your own
# server, another cloud, local testing). Leave all three empty on EC2 with
# a role attached; the controller then uses the role. An IAM user's key,
# least-privilege per docs/iam-policy.json, rotated periodically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
