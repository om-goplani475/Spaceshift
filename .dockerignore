# Only controller/ and requirements.txt are COPY'd into the image (see Dockerfile),
# but everything else in the tree is still sent to the daemon as build
# context - including real secrets. Keep it out.
.git
.github
venv
.env
*.pem
*.key
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
tests
docs/screenshots
docs/PLAN.md
docs/SETUP.md
*.md
config.yaml
